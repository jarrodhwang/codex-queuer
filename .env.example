CQ_API_TOKEN=change-this-before-exposing-port-6767
# Set this when the UI is mounted below a reverse-proxy path, e.g. /codex/.
VITE_BASE_PATH=/
HOST_PROJECT_ROOT=/home/jarrod
HOST_SSH_DIR=/home/jarrod/.ssh
CQ_CONTAINER_HOST_MOUNT_ROOT=/host/home/jarrod
CQ_DEFAULT_MACHINE_KIND=Ssh
CQ_DEFAULT_MACHINE_NAME=Local Linux
CQ_DEFAULT_MACHINE_PLATFORM=Linux
CQ_DEFAULT_WORKING_ROOT=/home/jarrod
CQ_DEFAULT_LOCAL_WORKING_ROOT=/host/home/jarrod
CQ_DEFAULT_SSH_HOST=host.docker.internal
CQ_DEFAULT_SSH_PORT=22
CQ_DEFAULT_SSH_USER=jarrod
CQ_DEFAULT_SSH_KEY_PATH=/home/app/.ssh/id_ed25519

# Optional first-slice Local/OpenHands profile. Replace the host with the
# private LAN/VPN address or DNS name of the central Ollama server.
# Docker deployments must pass these same names into the API container.
CQ_LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
CQ_LOCAL_AI_DEFAULT_MODEL=
CQ_LOCAL_AI_CONTEXT_WINDOW=65536

# Reserved secret names for a future credential-isolated cloud-provider increment.
# Current OpenHands execution intentionally rejects cloud/authenticated profiles.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
